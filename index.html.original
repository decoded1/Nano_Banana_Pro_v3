<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gemini 3 Pro - Infinite Canvas</title>
    <style>
        :root {
            --bg-color: #0f1115;
            --grid-dot: #2a2f3a;
            --glass-bg: rgba(20, 22, 26, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --accent-primary: #7c4dff;
            --accent-secondary: #448aff;
            --text-main: #ececec;
            --text-muted: #8b9bb4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            user-select: none;
        }

        /* --- WORKSPACE / ENGINE STYLES --- */
        .workspace {
            position: relative;
            width: 100%;
            height: 100%;
            /* Dot Matrix Background */
            background-image: radial-gradient(var(--grid-dot) 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            background-color: var(--bg-color);
            cursor: grab;
            overflow: hidden;
            box-shadow: inset 0 0 150px rgba(0,0,0,0.7);
        }
        .workspace:active { cursor: grabbing; }

        .view-transform-wrapper {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            transform-origin: 0 0;
            z-index: 2;
            pointer-events: none; /* Clicks pass through to canvas for panning */
        }

        .connection-svg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .wire {
            fill: none;
            stroke: #444;
            stroke-width: 2px;
            stroke-linecap: round;
            transition: stroke 0.3s;
        }
        
        /* Highlighting wires connected to selected nodes */
        .wire.active {
            stroke: var(--accent-secondary);
            filter: drop-shadow(0 0 4px var(--accent-secondary));
        }

        /* --- GEMINI IMAGE NODE STYLES --- */
        .node {
            position: absolute;
            width: 240px;
            /* Auto height based on content */
            background: #1a1d24;
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            pointer-events: auto;
            transition: transform 0.1s, box-shadow 0.2s, border-color 0.2s;
            display: flex;
            flex-direction: column;
            overflow: visible; /* Allow badges to pop out */
        }

        .node:hover {
            border-color: rgba(255,255,255,0.3);
            box-shadow: 0 15px 50px rgba(0,0,0,0.6);
            z-index: 10;
        }

        .node.selected {
            border: 2px solid var(--accent-primary);
            box-shadow: 0 0 0 4px rgba(124, 77, 255, 0.15);
        }

        .node.is-dragging {
            cursor: grabbing;
            transform: scale(1.02);
            z-index: 100;
            box-shadow: 0 20px 60px rgba(0,0,0,0.7);
        }

        /* Image Area */
        .node-image-container {
            width: 100%;
            height: 240px;
            border-radius: 16px 16px 0 0;
            overflow: hidden;
            background: #000;
            position: relative;
        }

        .node-image-container img {
            width: 100%; height: 100%; object-fit: cover;
            transition: opacity 0.3s;
            opacity: 0.9;
        }
        .node:hover .node-image-container img { opacity: 1; }

        /* Metadata Badge (e.g. 4K) */
        .meta-badge {
            position: absolute;
            top: 10px; right: 10px;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,0.1);
            z-index: 2;
        }

        /* Node Footer (Prompt) */
        .node-footer {
            padding: 12px;
            background: rgba(255,255,255,0.02);
            border-radius: 0 0 16px 16px;
            border-top: 1px solid rgba(255,255,255,0.05);
        }
        
        .node-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 4px;
        }
        
        .node-prompt {
            font-size: 10px;
            color: var(--text-muted);
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Ghost Node Specifics */
        .node.ghost {
            border: 1px dashed var(--text-muted);
            background: transparent;
            box-shadow: none;
        }
        .node.ghost .node-image-container {
            background: transparent;
            display: flex; align-items: center; justify-content: center; flex-direction: column;
        }
        .pulse-ring {
            width: 40px; height: 40px;
            border: 2px solid var(--accent-primary);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0% { transform: scale(0.8); opacity: 1; } 100% { transform: scale(2); opacity: 0; } }

        /* --- PORTS (Hidden but Functional) --- */
        /* We position input at top, output at bottom to create a Tree flow */
        .port-wrapper {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 20px; height: 20px;
            display: flex; align-items: center; justify-content: center;
            z-index: 5;
        }
        .port-wrapper.input { top: -10px; }
        .port-wrapper.output { bottom: -10px; }

        .port {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--text-muted);
            border: 2px solid var(--bg-color);
            cursor: crosshair;
            opacity: 0; /* Hidden until hover */
            transition: opacity 0.2s, transform 0.2s;
        }
        .node:hover .port { opacity: 1; }
        .port:hover { transform: scale(1.5); background: var(--accent-secondary); }

        /* --- UI OVERLAYS (From concept) --- */
        .ui-layer { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 100; }
        .ui-element { pointer-events: auto; }

        .top-bar {
            position: absolute; top: 20px; left: 30px; right: 30px;
            display: flex; justify-content: space-between;
        }
        .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px; letter-spacing: -0.02em; }
        .brand-dot { width: 8px; height: 8px; background: var(--accent-primary); border-radius: 50%; box-shadow: 0 0 10px var(--accent-primary); }

        .prompt-island {
            position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
            width: 650px; max-width: 90%;
            background: var(--glass-bg); backdrop-filter: blur(24px);
            border: 1px solid var(--glass-border); border-radius: 24px;
            padding: 12px; display: flex; align-items: center; gap: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.4);
        }
        .ref-dropzone {
            width: 48px; height: 48px; border: 1px dashed var(--text-muted); border-radius: 14px;
            display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--text-muted); cursor: pointer;
        }
        .prompt-input {
            flex-grow: 1; background: transparent; border: none; color: white; font-size: 15px; outline: none;
        }
        .generate-btn {
            background: linear-gradient(135deg, var(--accent-secondary), var(--accent-primary));
            color: white; border: none; height: 44px; padding: 0 24px; border-radius: 16px; font-weight: 600; cursor: pointer;
        }

        .left-drawer {
            position: absolute; left: 30px; top: 50%; transform: translateY(-50%);
            width: 70px; background: var(--glass-bg); backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border); border-radius: 35px; padding: 20px 0;
            display: flex; flex-direction: column; align-items: center; gap: 20px;
        }
        .drawer-item {
            width: 44px; height: 44px; border-radius: 12px; background: rgba(255,255,255,0.05);
            display: flex; justify-content: center; align-items: center; color: var(--text-muted); font-size: 18px; cursor: pointer;
        }
        .drawer-item.active { background: rgba(124, 77, 255, 0.2); color: var(--accent-primary); border: 1px solid var(--accent-primary); }

    </style>
</head>
<body>

    <!-- UI Layer (Floating Interface) -->
    <div class="ui-layer">
        <div class="top-bar">
            <div class="brand ui-element">
                <div class="brand-dot"></div>
                GEMINI 3 PRO / INFINITE CANVAS
            </div>
            <div class="brand ui-element" style="color: var(--text-muted);">
                Project: Neon Detective
            </div>
        </div>

        <div class="left-drawer ui-element">
            <div class="drawer-item active" title="References">R</div>
            <div class="drawer-item" title="Styles">S</div>
            <div class="drawer-item" title="History">H</div>
        </div>

        <div class="prompt-island ui-element">
            <div class="ref-dropzone">+</div>
            <input type="text" class="prompt-input" placeholder="Describe your imagination..." value="Make it day time, high contrast">
            <button class="generate-btn" onclick="addGhostNode()">Generate</button>
        </div>
    </div>

    <!-- The Engine Workspace -->
    <div id="workspace" class="workspace"></div>

    <script>
        // --- CORE ENGINE (Based on NodeScript System) ---

        class NodeSystem {
            constructor(containerId) {
                this.workspace = document.getElementById(containerId);
                this.nodes = new Map();
                this.connections = [];
                
                this.viewOffset = { x: 0, y: 0 };
                this.scale = 1;
                
                this.viewTransformWrapper = document.createElement('div');
                this.viewTransformWrapper.className = 'view-transform-wrapper';
                
                this.svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                this.svg.classList.add("connection-svg");
                
                this.workspace.appendChild(this.viewTransformWrapper);
                this.workspace.appendChild(this.svg);

                // Panning / Zooming
                this.workspace.addEventListener('wheel', this.handleWheel.bind(this), { passive: false });
                this.workspace.addEventListener('mousedown', this.handleMouseDown.bind(this));
            }

            handleWheel(e) {
                e.preventDefault();
                if (e.ctrlKey) {
                    // Zoom
                    const delta = e.deltaY * -0.001;
                    this.scale = Math.min(Math.max(0.5, this.scale + delta), 2);
                } else {
                    // Pan
                    this.viewOffset.x -= e.deltaX;
                    this.viewOffset.y -= e.deltaY;
                }
                this.updateTransform();
            }

            handleMouseDown(e) {
                // Only pan if clicking background
                if (e.target === this.workspace || e.target.classList.contains('view-transform-wrapper')) {
                    const startX = e.clientX;
                    const startY = e.clientY;
                    const startOffsetX = this.viewOffset.x;
                    const startOffsetY = this.viewOffset.y;

                    const onMouseMove = (ev) => {
                        this.viewOffset.x = startOffsetX + (ev.clientX - startX);
                        this.viewOffset.y = startOffsetY + (ev.clientY - startY);
                        this.updateTransform();
                    };

                    const onMouseUp = () => {
                        document.removeEventListener('mousemove', onMouseMove);
                        document.removeEventListener('mouseup', onMouseUp);
                    };

                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', onMouseUp);
                }
            }

            updateTransform() {
                this.viewTransformWrapper.style.transform = 
                    `translate(${this.viewOffset.x}px, ${this.viewOffset.y}px) scale(${this.scale})`;
                this.updateAllConnections();
            }

            addNode(config) {
                const node = new Node(config, this);
                this.nodes.set(node.id, node);
                this.viewTransformWrapper.appendChild(node.element);
                return node;
            }

            connect(sourceId, targetId) {
                const sourceNode = this.nodes.get(sourceId);
                const targetNode = this.nodes.get(targetId);
                
                if (!sourceNode || !targetNode) return;

                const connection = {
                    id: `conn_${sourceId}_${targetId}`,
                    sourceNode,
                    targetNode,
                    wire: document.createElementNS("http://www.w3.org/2000/svg", "path")
                };

                connection.wire.classList.add("wire");
                this.connections.push(connection);
                this.svg.appendChild(connection.wire);
                this.updateConnection(connection);
            }

            updateConnection(conn) {
                // Connect Bottom of Source to Top of Target
                const outRect = conn.sourceNode.ports.output.getBoundingClientRect();
                const inRect = conn.targetNode.ports.input.getBoundingClientRect();
                const wsRect = this.workspace.getBoundingClientRect();

                // Adjust for view transform (scale/translate) calculation is complex if done raw,
                // simpler to just map based on viewport coordinates relative to SVG
                const startX = (outRect.left + outRect.width/2 - wsRect.left);
                const startY = (outRect.top + outRect.height/2 - wsRect.top);
                const endX = (inRect.left + inRect.width/2 - wsRect.left);
                const endY = (inRect.top + inRect.height/2 - wsRect.top);

                // Bézier Curve Logic
                const dist = Math.abs(endY - startY);
                const controlOffset = Math.max(dist * 0.5, 50);

                const pathData = `M ${startX} ${startY} C ${startX} ${startY + controlOffset}, ${endX} ${endY - controlOffset}, ${endX} ${endY}`;
                conn.wire.setAttribute("d", pathData);
            }

            updateAllConnections() {
                this.connections.forEach(conn => this.updateConnection(conn));
            }
        }

        class Node {
            constructor(config, system) {
                this.id = config.id;
                this.title = config.title || "Generation";
                this.prompt = config.prompt || "";
                this.image = config.image || "";
                this.badge = config.badge || "2K";
                this.isGhost = config.isGhost || false;
                this.position = { ...config.position };
                this.system = system;

                this.element = this.createNodeElement();
                this.ports = {}; // To store DOM elements for connections
                
                this.updatePosition();
                this.attachDragHandlers();
            }

            createNodeElement() {
                const el = document.createElement('div');
                el.className = `node ${this.isGhost ? 'ghost' : ''}`;
                el.id = this.id;

                // Internal Structure
                if (this.isGhost) {
                    el.innerHTML = `
                        <div class="port-wrapper input"><div class="port"></div></div>
                        <div class="node-image-container">
                            <div class="pulse-ring"></div>
                            <div style="margin-top:10px; font-size:10px; color:var(--accent-primary);">Thinking...</div>
                        </div>
                    `;
                } else {
                    el.innerHTML = `
                        <div class="port-wrapper input"><div class="port"></div></div>
                        <div class="node-image-container">
                            <div class="meta-badge">${this.badge}</div>
                            <img src="${this.image}" draggable="false">
                        </div>
                        <div class="node-footer">
                            <div class="node-title">${this.title}</div>
                            <div class="node-prompt">${this.prompt}</div>
                        </div>
                        <div class="port-wrapper output"><div class="port"></div></div>
                    `;
                }

                return el;
            }

            updatePosition() {
                this.element.style.left = `${this.position.x}px`;
                this.element.style.top = `${this.position.y}px`;
            }

            attachDragHandlers() {
                // Cache port references after render
                this.ports.input = this.element.querySelector('.port-wrapper.input');
                this.ports.output = this.element.querySelector('.port-wrapper.output');

                let isDragging = false;
                let dragStartPos, mouseStartPos;

                const onMouseDown = (e) => {
                    // Don't drag if clicking ports (future wiring logic)
                    if (e.target.classList.contains('port')) return;
                    
                    e.stopPropagation(); // Prevent canvas pan
                    e.preventDefault();

                    isDragging = true;
                    this.element.classList.add('is-dragging');
                    this.element.classList.add('selected');
                    
                    dragStartPos = { x: this.position.x, y: this.position.y };
                    mouseStartPos = { x: e.clientX, y: e.clientY };

                    // Account for scale in drag
                    const scale = this.system.scale;

                    const onMouseMove = (ev) => {
                        const deltaX = (ev.clientX - mouseStartPos.x) / scale;
                        const deltaY = (ev.clientY - mouseStartPos.y) / scale;
                        
                        this.position.x = dragStartPos.x + deltaX;
                        this.position.y = dragStartPos.y + deltaY;
                        
                        this.updatePosition();
                        this.system.updateAllConnections();
                    };

                    const onMouseUp = () => {
                        isDragging = false;
                        this.element.classList.remove('is-dragging');
                        document.removeEventListener('mousemove', onMouseMove);
                        document.removeEventListener('mouseup', onMouseUp);
                    };

                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', onMouseUp);
                };

                this.element.addEventListener('mousedown', onMouseDown);
            }
        }

        // --- INITIALIZATION & DEMO SCENARIO ---

        const system = new NodeSystem('workspace');

        // 1. Create the "Story"
        const rootNode = system.addNode({
            id: 'root',
            title: 'Root Prompt',
            prompt: 'Cyberpunk detective office, neon rain outside window, high detail',
            image: 'https://picsum.photos/id/237/300/300',
            badge: '2K',
            position: { x: 600, y: 100 }
        });

        const var1 = system.addNode({
            id: 'var1',
            title: 'Variation A',
            prompt: 'Same prompt, seed 8823',
            image: 'https://picsum.photos/id/238/300/300',
            badge: '2K',
            position: { x: 400, y: 450 }
        });

        const var2 = system.addNode({
            id: 'var2',
            title: 'Variation B',
            prompt: 'Same prompt, seed 9910',
            image: 'https://picsum.photos/id/239/300/300',
            badge: '4K',
            position: { x: 800, y: 450 }
        });

        const editNode = system.addNode({
            id: 'edit1',
            title: 'Edit Step',
            prompt: 'Make it day time, remove neon',
            image: 'https://picsum.photos/id/240/300/300',
            badge: '4K',
            position: { x: 800, y: 800 }
        });

        // 2. Wire them up (Genealogy)
        // Root -> Var 1
        system.connect('root', 'var1');
        // Root -> Var 2
        system.connect('root', 'var2');
        // Var 2 -> Edit
        system.connect('var2', 'edit1');

        // 3. Center View Initial
        system.viewOffset = { x: 0, y: 0 };
        system.updateTransform();

        // 4. Interaction Simulation
        function addGhostNode() {
            const ghost = system.addNode({
                id: 'ghost_' + Date.now(),
                isGhost: true,
                position: { x: 1100, y: 450 } // To the right
            });
            system.connect('root', ghost.id);
            
            // Simulate completion
            setTimeout(() => {
                ghost.element.remove();
                system.nodes.delete(ghost.id);
                // In real app, replace with real node
                const newNode = system.addNode({
                    id: 'new_' + Date.now(),
                    title: 'New Generation',
                    prompt: 'Make it day time...',
                    image: 'https://picsum.photos/id/241/300/300',
                    badge: '4K',
                    position: { x: 1100, y: 450 }
                });
                system.connect('root', newNode.id);
                system.updateAllConnections();
            }, 2000);
        }

    </script>
</body>
</html>